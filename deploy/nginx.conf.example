# nginx + php-fpm. Alleen de map public/ is bereikbaar; .env, src/, storage/ staan erbuiten.
server {
    listen 80;
    server_name wilsverklaring.example.nl;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wilsverklaring.example.nl;

    ssl_certificate     /etc/letsencrypt/live/wilsverklaring.example.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wilsverklaring.example.nl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/wilsverklaring/public;
    index index.php;
    client_max_body_size 1m;
    server_tokens off;

    # statische bestanden direct, de rest naar de applicatie
    location / {
        try_files $uri /index.php$is_args$args;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # uitsluitend index.php wordt uitgevoerd
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
