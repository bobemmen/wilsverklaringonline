# --- Applicatie ---------------------------------------------------------
APP_NAME=WilsVerklaring
APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=https://wilsverklaring.example.nl   # verplicht in productie (wordt gebruikt in e-mails en links)
APP_TIMEZONE=Europe/Amsterdam

# Hoofdsleutel voor alle versleuteling. Wordt gegenereerd door: php bin/console install
# Bewaar een kopie op een veilige plek, APART van de database-back-ups. Verlies = gegevens onherstelbaar.
APP_KEY=

# --- Database (één SQLite-bestand, alle gegevens daarin zijn versleuteld) ---
DB_PATH=storage/database/wilsverklaring.sqlite

SESSION_LIFETIME=120          # minuten inactiviteit

# Achter een reverse proxy (nginx/Caddy)? Zet hier het IP van de proxy, kommagescheiden.
TRUSTED_PROXIES=

# --- E-mail (nodig voor de bevestigingsmail naar de arts) ----------------
# MAIL_DRIVER=smtp | mail | log   (log = alleen voor ontwikkeling)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls           # tls (STARTTLS) | ssl | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@wilsverklaring.example.nl
MAIL_FROM_NAME=WilsVerklaring

# --- Pilot en juridische teksten (worden in /pilot, /privacy en /voorwaarden getoond) ---
OPERATOR_NAME=
OPERATOR_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PILOT_PRACTICE_NAME=

# Demo van de patiëntomgeving (echte pagina's, tijdelijk account per bezoeker, na afloop verwijderd).
# Zet op true om de knop "Bekijk de demo" te tonen. Laat op false als u dat niet wilt.
DEMO_ENABLED=false
DEMO_TTL_MINUTES=120
DEMO_MAX=50
